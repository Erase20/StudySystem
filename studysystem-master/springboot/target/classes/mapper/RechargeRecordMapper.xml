<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.RechargeRecordMapper">

    <sql id="Base_Column_List">
        id,recordid,price,time,user_id,method
    </sql>

    <select id="selectAll" resultType="com.example.entity.RechargeRecord">
        select
        rechargerecord.*, user.name as userName
        from rechargerecord
        left join user on rechargerecord.user_id = user.id
        <where>
            <if test="id != null"> and id= #{id}</if>
            <if test="userId != null"> and user_id = #{userId}</if>
        </where>
        order by id desc
    </select>

    <select id="selectById" resultType="com.example.entity.RechargeRecord">
        select
        <include refid="Base_Column_List" />
        from rechargerecord
        where id = #{id}
    </select>

    <delete id="deleteById">
        delete from rechargerecord
        where  id = #{id}
    </delete>

    <insert id="insert" parameterType="com.example.entity.RechargeRecord" useGeneratedKeys="true">
        insert into rechargerecord
        <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="id != null">id,</if>
                <if test="recordid != null">recordid,</if>
                <if test="price != null">price,</if>
                <if test="time != null">time,</if>
                <if test="userId != null">user_id,</if>
                <if test="method != null">method,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                <if test="id != null">#{id},</if>
                <if test="recordid != null">#{recordid},</if>
                <if test="price != null">#{price},</if>
                <if test="time != null">#{time},</if>
                <if test="userId != null">#{userId},</if>
                <if test="method != null">#{method},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.example.entity.RechargeRecord">
        update rechargerecord
        <set>
            <if test="recordid != null">
                recordid = #{recordid},
            </if>
            <if test="price != null">
                price = #{price},
            </if>
            <if test="time != null">
                time = #{time},
            </if>
            <if test="userId != null">
                user_id = #{userId},
            </if>
        </set>
        where id = #{id} 
    </update>

</mapper>