<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.LearningPlanMapper">

    <sql id="Base_Column_List">
        id, user_id, title, content, target_course_id, daily_goal, start_date, end_date, status, progress, create_time, update_time
    </sql>

    <select id="selectById" resultType="com.example.entity.LearningPlan">
        select <include refid="Base_Column_List" /> from learning_plan where id = #{id}
    </select>

    <select id="selectAll" resultType="com.example.entity.LearningPlan">
        select <include refid="Base_Column_List" /> from learning_plan
        <where>
            <if test="userId != null"> and user_id = #{userId}</if>
            <if test="status != null"> and status = #{status}</if>
        </where>
        order by create_time desc
    </select>

    <insert id="insert" parameterType="com.example.entity.LearningPlan" useGeneratedKeys="true">
        insert into learning_plan
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="title != null">title,</if>
            <if test="content != null">content,</if>
            <if test="targetCourseId != null">target_course_id,</if>
            <if test="dailyGoal != null">daily_goal,</if>
            <if test="startDate != null">start_date,</if>
            <if test="endDate != null">end_date,</if>
            <if test="status != null">status,</if>
            <if test="progress != null">progress,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="title != null">#{title},</if>
            <if test="content != null">#{content},</if>
            <if test="targetCourseId != null">#{targetCourseId},</if>
            <if test="dailyGoal != null">#{dailyGoal},</if>
            <if test="startDate != null">#{startDate},</if>
            <if test="endDate != null">#{endDate},</if>
            <if test="status != null">#{status},</if>
            <if test="progress != null">#{progress},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.example.entity.LearningPlan">
        update learning_plan
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="content != null">content = #{content},</if>
            <if test="targetCourseId != null">target_course_id = #{targetCourseId},</if>
            <if test="dailyGoal != null">daily_goal = #{dailyGoal},</if>
            <if test="startDate != null">start_date = #{startDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="status != null">status = #{status},</if>
            <if test="progress != null">progress = #{progress},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        where id = #{id}
    </update>

    <delete id="deleteById">
        delete from learning_plan where id = #{id}
    </delete>

</mapper>
